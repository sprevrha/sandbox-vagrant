# File: .env
# This file contains environment variables for the sandbox-vagrant application.
# Will be sourced by make, vagrant and docker
# CAVEATS: 
#   No same-line comments!
#   Make does not resolve references, i.e. no X=$Y.blah. Vagrant and Dokcer do.
VSCODE_ENV_REPLACE=
# Application Domain
APP_DOMAIN=sandbox-vagrant.app
# Application Name
APP_NAME=sandbox-vagrant
# Application Description
APP_DESCRIPTION="A Vagrant-based sandbox environment for development and testing."
# Application Version
APP_VERSION=1.0.0
# Application Install Directory
APP_INSTALL_DIR=/opt/$APP_NAME   
APP_CONF_DIR=/opt/conf/$APP_NAME              
# Application Path
APP_PATH=/var/www/html
# Application URL
APP_URL=http://$APP_DOMAIN
# Application SSL URL
APP_SSL_URL=https://$APP_DOMAIN
# Application Environment
APP_ENV=development
# Application Debug Mode
APP_DEBUG=true
# Application Timezone
APP_TIMEZONE=Europe/Berlin
# Application Locale
APP_LOCALE=de_DE.UTF-8
# Application Charset
APP_CHARSET=UTF-8
# Application Key (should be set to a secure random value)
APP_KEY=base64:random_string_here
# Application Cache Driver
APP_CACHE_DRIVER=file
# Application Session Driver
APP_SESSION_DRIVER=file
# Application Queue Driver
APP_QUEUE_DRIVER=sync
# Application Log Level
APP_LOG_LEVEL=debug
# Application Log Paths
APP_LOG_DIR=/var/log/$APP_NAME
APP_LOG_PATH=/var/log/$APP_NAME.log
# Application Log Channel
APP_LOG_CHANNEL=stack
# Application Log Format
APP_LOG_FORMAT=single

# Debuggging
VAGRANT_DEBUG=1

# Make vars - these cannot refer to other vars, i.e. no MAKE_DIR=$APP_DIR
MAKE_DIR=.
# MAKE_DEBUG_OUTPUT=--debug 2>&1 | tee -a logs/vagrant_debug_clean_start.log
MAKE_DEBUG_OUTPUT=

# Docker Configuration
DOCKER_DOWNLOAD_URL=https://download.docker.com/linux/ubuntu
# Docker network name
DOCKER_NETWORK=docker_network 
# Docker network driver
DOCKER_NETWORK_DRIVER=bridge 
DOCKER_CONTAINER_LOG_DIR=$APP_INSTALL_DIR/logs
DOCKER_BINDMOUNT_ROOT=$APP_INSTALL_DIR

## Now the Docker Services Configuration
# Database Configuration
DB_IMAGE=mariadb:10.11
DB_CONTAINER_NAME=db
# Application Database Name
DB_NAME=$APP_NAME           
# Wordpress Configuration
WORDPRESS_IMAGE=wordpress:php8.3-fpm-alpine
WORDPRESS_CONTAINER_NAME=wordpress


# Nginx Ports
NGINX_IMAGE=nginx:1.25.5-alpine
NGINX_CONTAINER_NAME=nginx
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Nginx SSL Paths (assuming these are constant for the environment)
NGINX_SSL_CERT_PATH=/etc/ssl/certs/ssl-cert-snakeoil.pem
NGINX_SSL_KEY_PATH=/etc/ssl/private/ssl-cert-snakeoil.key
NGINX_SSL_TRUSTED_CERT_PATH=/etc/ssl/certs/ca-certificates.crt
NGINX_SSL_DHPARAM_PATH=/etc/ssl/certs/dhparam.pem

# Nginx Performance & Security Settings (values that might change per environment or tuning)
NGINX_CLIENT_BODY_BUFFER_SIZE=128k
NGINX_CLIENT_HEADER_BUFFER_SIZE=1k
NGINX_CLIENT_MAX_BODY_SIZE=100M
NGINX_CLIENT_BODY_TIMEOUT=60s
NGINX_CLIENT_HEADER_TIMEOUT=60s
NGINX_KEEPALIVE_TIMEOUT=65
NGINX_SEND_TIMEOUT=60
NGINX_GZIP_COMP_LEVEL=5
NGINX_GZIP_MIN_LENGTH=256
NGINX_TYPES_HASH_MAX_SIZE=2048
NGINX_TYPES_HASH_BUCKET_SIZE=64
NGINX_TYPES_HASH_MIN_USES=1
NGINX_TYPES_HASH_BUCKETS=64
NGINX_RESOLVER=8.8.8.8 8.8.4.4
NGINX_RESOLVER_TIMEOUT=5s
NGINX_RESOLVER_VALIDITY=10s
NGINX_PROXY_READ_TIMEOUT=90s
NGINX_PROXY_CONNECT_TIMEOUT=90s
NGINX_PROXY_SEND_TIMEOUT=90s
NGINX_PROXY_BUFFER_SIZE=16k
NGINX_PROXY_BUFFERS=4 16k
NGINX_PROXY_BUSY_BUFFERS_SIZE=32k
NGINX_PROXY_MAX_TEMP_FILE_SIZE=0
NGINX_PROXY_TEMP_FILE_SIZE=64k
NGINX_PROXY_TEMP_FILE_WRITE_SIZE=64k
NGINX_SSL_SESSION_CACHE=shared:SSL:10m
NGINX_SSL_SESSION_TIMEOUT=10m
NGINX_SSL_STAPLING_RESPONSE_TIMEOUT=5s
NGINX_SSL_VERIFY_DEPTH=2

# WordPress Memory Limits
WP_MEMORY_LIMIT=256M
WP_MAX_MEMORY_LIMIT=512M

# Vagrant Configuration
VAGRANT_DIR=./
VAGRANT_SSH_HOST_PORT=2222
# Vagrant needs RW permissions to these
VAGRANT_APPCODE_DIR=/home/vagrant/$APP_NAME
VAGRANT_APPCONF_DIR=/home/vagrant/conf/$APP_NAME
# How are we are going to sync files? # Options: git-pull, rsync
VAGRANT_APPCODE_SYNC_METHOD=git-pull 
VAGRANT_OS=ubuntu
VAGRANT_OS_RELEASE=jammy
VAGRANT_OS_RELEASE_BITNESS=64
VAGRANT_OS_RELEASE_VERSION=22.04
VAGRANT_OS_RELEASE_BUILD=20231010.0.0
VAGRANT_GUEST_HTTP_PORT=$NGINX_HTTP_PORT
VAGRANT_HOST_HTTP_PORT=8090
VAGRANT_GUEST_HTTPS_PORT=$NGINX_HTTPS_PORT
VAGRANT_HOST_HTTPS_PORT=8443
# chrome, safari, firefox, edge
VAGRANT_HOST_BROWSER="firefox" 
VAGRANT_BOX_NAME=$VAGRANT_OS/$VAGRANT_OS_RELEASE$VAGRANT_OS_RELEASE_BITNESS
VAGRANT_HOST_NAME=$APP_NAME
VAGRANT_VM_PROVIDER=virtualbox
VAGRANT_VM_MEMORY=2048
VAGRANT_VM_CPUS=2
VAGRANT_VM_APP_LOG_DIR=/var/log/$APP_NAME
VAGRANT_VM_TIMEZONE=$APP_TIMEZONE
# A list of extra files to be copied to the VM,
# after the app code is pulled or copied
# for directories that are not under git control but still needed
VAGRANT_EXTRA_DIRS_TO_COPY=./secrets ./ssl-certs

# GIT Configuration
GIT_REPO_URL=https://github.com/sprevrha/sandbox-vagrant.git
GIT_BRANCH=issue-2-fastcgi

# LOG Paths
LOG_PATH=/var/log/$APP_NAME
